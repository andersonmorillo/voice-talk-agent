{
  "name": "talk-to-cursor",
  "version": "1.0.0",
  "description": "Hands-free voice MCP for Cursor, Claude Code, and Codex. Local Pocket TTS by default, with optional ElevenLabs cloud TTS.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "talk-to-cursor": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "settings": "node build/settings-server.js",
    "pocket-tts": "node build/start-pocket-tts.js",
    "install-tts": "uv tool install pocket-tts",
    "auto-submit": "python scripts/auto-submit.py",
    "mcp": "node build/index.js",
    "setup-agents": "node scripts/setup-agents.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "text-to-speech",
    "elevenlabs",
    "cursor",
    "claude-code",
    "codex",
    "tts",
    "voice",
    "hands-free",
    "dictation",
    "model-context-protocol",
    "ai-assistant"
  ],
  "author": "nosre",
  "license": "MIT",
  "files": [
    "build/",
    "public/",
    "scripts/*.py",
    "scripts/*.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.34.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express": "^5.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
