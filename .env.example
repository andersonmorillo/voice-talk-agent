# Pocket TTS is the default. No API key required.
# Copy this file to .env only if you want environment overrides.

TTS_PROVIDER=pocket-tts
POCKET_TTS_URL=http://127.0.0.1:8000
POCKET_TTS_VOICE=alba
TTS_VOLUME=1.0

# Optional: switch to ElevenLabs cloud TTS
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=your_api_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
