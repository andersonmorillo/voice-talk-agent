# Pocket TTS is the default. No API key required.
# Copy this file to .env only if you want environment overrides.

TTS_PROVIDER=pocket-tts
POCKET_TTS_SPEECH_LANGUAGE=auto
POCKET_TTS_URL=http://127.0.0.1:18741
POCKET_TTS_VOICE=alba
POCKET_TTS_LANGUAGE=english
POCKET_TTS_SPANISH_URL=http://127.0.0.1:18742
POCKET_TTS_SPANISH_VOICE=lola
POCKET_TTS_SPANISH_LANGUAGE=spanish_24l
TTS_VOLUME=1.0

# Optional: lock to one language instead of auto-detect
# POCKET_TTS_SPEECH_LANGUAGE=english
# POCKET_TTS_SPEECH_LANGUAGE=spanish

# Optional: switch to ElevenLabs cloud TTS
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=your_api_key_here
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
